{
  "name": "portless-studio",
  "version": "0.2.2",
  "description": "A local web dashboard for portless: see every dev server, name its port and open it.",
  "license": "MIT",
  "author": "Keven Bardales",
  "homepage": "https://github.com/keven-bardales/portless-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keven-bardales/portless-studio.git"
  },
  "bugs": {
    "url": "https://github.com/keven-bardales/portless-studio/issues"
  },
  "keywords": [
    "portless",
    "localhost",
    "dev-server",
    "ports",
    "dashboard",
    "mcp",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "portless-studio": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/cli/index.ts --no-open --port 4949",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "start": "node dist/cli/index.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "node --run typecheck && node --run test && node --run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node-tests.json",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "geist": "^1.7.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
